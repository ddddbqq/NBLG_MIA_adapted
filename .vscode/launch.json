{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/MCHLG", 
            //./build/MCHLG 
            //-doParallel false 
            //-lef ./benchmarks/$benchmark/tech.lef 
            //-lef ./benchmarks/$benchmark/cells_modified.lef 
            //-def ./benchmarks/$benchmark/placed.def 
            //-placement_constraints ./benchmarks/$benchmark/placement.constraints 
            //-output_def ./output/$benchmark.def
            "args": [
                "-doParallel",
                "false",
                "-lef",
                "${workspaceFolder}/benchmarks/${input:benchmark}/tech.lef",
                "-lef",
                "${workspaceFolder}/benchmarks/${input:benchmark}/cells_modified.lef",
                "-def",
                "${workspaceFolder}/benchmarks/${input:benchmark}/placed.def",
                "-placement_constraints",
                "${workspaceFolder}/benchmarks/${input:benchmark}/placement.constraints",
                "-output_def",
                "${workspaceFolder}/output/${input:benchmark}.def"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            //"preLaunchTask": "do_nothing" 
            "preLaunchTask": "build" 
        }
    ],
    "inputs": [
        { 
            "id": "benchmark",
            "type": "promptString",
            "description": "Enter benchmark name (e.g., fft_2_md2)",
            // benchmark=(des_perf_1 des_perf_a_md1  des_perf_b_md1  edit_dist_1_md1  edit_dist_a_md3  fft_a_md2  pci_bridge32_a_md1  pci_bridge32_b_md1  pci_bridge32_b_md3
            // des_perf_a_md2  des_perf_b_md2  edit_dist_a_md2  fft_2_md2        fft_a_md3  pci_bridge32_a_md2  pci_bridge32_b_md2)
            "default": "mgc_pci_bridge32_1"  
        }
    ]
}